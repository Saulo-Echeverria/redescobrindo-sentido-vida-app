{
  "name": "redescobrindo-sentido-da-vida",
  "version": "1.0.0",
  "description": "App de autodescoberta existencial baseado na Logoterapia de Viktor Frankl",
  "private": true,
  "scripts": {
    "build": "echo 'Static app — no build step needed'",
    "cap:init": "npx cap init 'Sentido da Vida' com.redescobrindosentido.app --web-dir app",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run:android": "npx cap run android",
    "cap:run:ios": "npx cap run ios",
    "cap:update": "npx cap update",
    "cap:copy": "npx cap copy",
    "android:release": "cd android && ./gradlew bundleRelease",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "icons": "npx @capacitor/assets generate --iconBackgroundColor '#0f0f1a' --iconBackgroundColorDark '#0f0f1a' --splashBackgroundColor '#0f0f1a' --splashBackgroundColorDark '#0f0f1a'",
    "lint": "echo 'No linter configured'",
    "serve": "npx serve app -p 3000"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.0",
    "@capacitor/cli": "^6.0.0",
    "serve": "^14.0.0"
  },
  "keywords": [
    "logoterapia",
    "viktor-frankl",
    "sentido-da-vida",
    "psicologia-positiva",
    "pwa",
    "capacitor",
    "ionic"
  ],
  "author": "Redescobrindo o Sentido da Vida",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}